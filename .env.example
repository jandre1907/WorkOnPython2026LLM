# Configuration for minimal E2E trainer
# Copy this to .env and customize for your environment

# Training parameters
NUM_EPOCHS=10
SEQ_LENGTH=16
BASE_TEXT="hello world "
NB_COPY=8

# Generation parameters
SEED="hello "
TEMPERATURE=0

# Checkpoint loading (optional)
# Set to a path like "models/model_epoch_10.pkl" to load instead of training
# CHECKPOINT="models/model_epoch_10.pkl"
